{
  "name": "03-api-solid",
  "version": "1.0.0",
  "description": "Gympass style app with Fastify and TypeScript",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start:dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts src/app.ts --out-dir build --format esm",
    "start": "node build/server.js",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "node",
    "fastify",
    "typescript",
    "api"
  ],
  "author": "Daniel Fernandes",
  "license": "MIT",
  "devDependencies": {
    "@rocketseat/eslint-config": "2.2.2",
    "@types/node": "24.3.0",
    "eslint": "8.57.1",
    "prisma": "6.14.0",
    "tsup": "8.5.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "dotenv": "17.2.1",
    "fastify": "5.5.0",
    "zod": "4.0.17"
  }
}
